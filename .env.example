# Written Realms Environment Configuration Template
# Run ./scripts/setup-dev (or make setup) to generate .env with local secrets.
# For manual setup, copy this file to .env and replace the three required secrets.

# Database Configuration
POSTGRES_DB=wrealms
POSTGRES_USER=django
POSTGRES_PASSWORD=your_secure_database_password_here

# Django Configuration
DJANGO_SECRET_KEY=your_django_secret_key_here_min_50_chars
DJANGO_SETTINGS_MODULE=backend.config.settings.container

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_50_chars

# AWS Configuration (for backups)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=

# Sentry/Error Tracking (optional)
SENTRY_DSN=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Email Configuration (optional)
MONITORING_EMAIL=
SYSTEM_EMAIL_FROM=noreply@example.com

# Communication moderation archive (optional)
COMMUNICATION_RETENTION_DAYS=3
COMMUNICATION_PRUNE_BATCH_SIZE=10000

# Frontend local URLs are already configured in frontend/.env.localBackend.

# Optional shared LLM connection (disabled until an operator configures/enables it).
# One OpenAI or Anthropic key. See docs/guides/administrators/llm-integration.md.
# Uncomment to include the dedicated worker on every normal Compose startup.
# COMPOSE_PROFILES=ai
WR_LLM_API_KEY=
WR_LLM_OPENAI_PROJECT=
# WR_LLM_WORKER=1 is set only on the dedicated llm-worker service, never globally.
# Platform admission is managed in the database through /staff (Access).

# Independent world-upkeep controls; disabling preserves timers for later retry.
WR_ITEM_UPKEEP_ENABLED=true
WR_DOOR_UPKEEP_ENABLED=true

#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/reset-dev-db [--mount] [--build] [--no-start] [--yes]

Reset the local Docker-backed Postgres database to a fresh install.

This will:
  1. Stop the local Docker Compose stack
  2. Delete only this Compose project's PostgreSQL named volume
  3. Start the stack again so PostgreSQL and Django rebuild the database

Other volumes and the old ./data/db directory are preserved.
Requires Docker Compose and Python 3 on the host.

Options:
  --mount     Use docker-compose.mount.yml for the bind-mount workflow.
  --build     Rebuild images when starting the stack again.
  --no-start  Remove the database volume but leave the stack stopped.
  --yes       Skip the confirmation prompt.
  --help      Show this help text.
EOF
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

use_mount=0
build_after=0
start_after=1
skip_confirm=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --mount)
            use_mount=1
            ;;
        --build)
            build_after=1
            ;;
        --no-start)
            start_after=0
            ;;
        --yes)
            skip_confirm=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

compose_cmd=(docker compose)
compose_desc="${COMPOSE_FILE:-docker-compose.yml}"
if [[ $use_mount -eq 1 ]]; then
    compose_cmd=(docker compose -f docker-compose.yml -f docker-compose.mount.yml)
    compose_desc="docker-compose.yml + docker-compose.mount.yml"
fi

cd "$repo_root"

# Resolve Compose's actual volume name, including COMPOSE_PROJECT_NAME and
# overlays. Refuse bind mounts or external volumes rather than deleting data
# whose lifecycle is not owned by this project's Compose configuration.
db_volume="$("${compose_cmd[@]}" config --format json | python3 -c '
import json
import sys

config = json.load(sys.stdin)
mounts = [mount for mount in config["services"]["db"].get("volumes", [])
          if mount["target"] == "/var/lib/postgresql/data"]
if len(mounts) != 1 or mounts[0]["type"] != "volume":
    sys.exit("Refusing reset: PostgreSQL must use a named volume.")
volume = config["volumes"][mounts[0]["source"]]
if volume.get("external") or not volume.get("name"):
    sys.exit("Refusing reset: PostgreSQL volume must be managed by Compose.")
print(volume["name"])
')"

if [[ $skip_confirm -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
        echo "Refusing to reset without confirmation in a non-interactive shell. Re-run with --yes." >&2
        exit 1
    fi

    echo "This will permanently delete the local PostgreSQL volume:"
    echo "  $db_volume"
    echo "Compose config:"
    echo "  $compose_desc"
    echo
    read -r -p "Continue? [y/N] " reply
    case "$reply" in
        y|Y|yes|YES)
            ;;
        *)
            echo "Cancelled."
            exit 0
            ;;
    esac
fi

echo "==> Stopping Docker Compose stack..."
"${compose_cmd[@]}" down --remove-orphans

if docker volume inspect "$db_volume" >/dev/null 2>&1; then
    echo "==> Removing PostgreSQL volume $db_volume..."
    docker volume rm "$db_volume"
else
    echo "==> PostgreSQL volume $db_volume does not exist; nothing to reset."
fi

if [[ $start_after -eq 0 ]]; then
    echo "==> Database volume reset. Stack left stopped because --no-start was provided."
    exit 0
fi

up_args=(up -d)
if [[ $build_after -eq 1 ]]; then
    up_args+=(--build)
fi

echo "==> Starting Docker Compose stack..."
"${compose_cmd[@]}" "${up_args[@]}"

echo
echo "Reset complete. The backend will rerun migrations on startup."
echo "Tail logs with:"
echo "  ${compose_cmd[*]} logs -f backend"
